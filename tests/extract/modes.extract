foo = \lyricmode { la la la }
                   ^^^^^
---
music = \lyricmode { la la }

foo = \lyricmode { \music la }
===
foo = \chordmode { c f g }
                   ^^^
---
music = \chordmode { c4 f }

foo = \chordmode { \music g }
===
\chordmode { \repeat unfold 2 { c:m g:7 }}
                                ^^^
---
music = \chordmode { c4:m }

\chordmode { \repeat unfold 2 { \music g:7 }}
===
onlyDuration = \chordmode { c2 a4 }
                             ^
---
INVALID
===
loseDuration = \chordmode { c2 a4 }
                            ^
---
INVALID
===
onlyShape = \chordmode { c2 a:m f g }
                             ^^^
---
INVALID
===
loseShape = \chordmode { c2 a:m f g }
                            ^
---
INVALID
===
onlyInversion = \chordmode { c/e f g }
                              ^^^
---
INVALID
===
loseInversion =  = \chordmode { c/e f g }
                                ^
---
INVALID
===
foo = \lyrics { la la la }
                ^^^^^
---
music = \lyricmode { la la }

foo = \lyrics { \music la }
===
foo = \chords { c f g }
                ^^^
---
music = \chordmode { c4 f }

foo = \chords { \music g }
===
foo = \drummode { bd sn hh }
                  ^^^^^
---
music = \drummode { bd sn }

foo = \drummode { \music hh }
===
foo = \drums { bd sn hh }
               ^^^^^
---
music = \drummode { bd sn }

foo = \drums { \music hh }
===
foo = \figuremode { <4> <6> <5> }
                    ^^^^^^^
---
music = \figuremode { <4> <6> }

foo = \figuremode { \music <5> }
===
foo = \figures { <4> <6> <5> }
                 ^^^^^^^
---
music = \figuremode { <4> <6> }

foo = \figures { \music <5> }
===
foo = \markup { hello world now }
                ^^^^^^^^^^^
---
music = \markup { hello world }

foo = \markup { \music now }
===
\chordmode { \notemode { c d e } }
                         ^^^
---
music = { c4 d }

\chordmode { \notemode { \music e } }
